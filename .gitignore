# --- dependencies & generated client libs -------------------------------------------------------
node_modules/
# copied from node_modules by tools/vendor.mjs (postinstall); never commit third-party builds
public/vendor/

# --- game assets: (c) Hypergryph / Yostar, fetched or extracted locally, NEVER committed ----------
# tools/fetch-assets.mjs → public/assets/** (~250 MB) and public/fonts/** (+ fonts.css)
public/assets/
public/fonts/
# tools/local-extract/extract.py → public/assets/local/** and this per-machine manifest
# (optional: the client and the tests work without it)
data/local-assets.json
# download caches, upstream tables, ledgers, reports, setup state
.cache/
.static-compressed/
.state/
match-history.json
player-registry.json
ranked-profiles.json
profile-replication-main.json
profile-replication-*.json
profile-pending-*.json
runtime-state*.json
server-state*.json
sessions*.json

# --- Python (optional local-client extraction) ----------------------------------------------------
.venv*/
venv/
__pycache__/
*.py[cod]

# --- tests & logs ----------------------------------------------------------------------------------
test/e2e/out/
logs/
*.log
.tmp-test.mjs
echo-*.png
add-*.mjs
fix-*.mjs
pass-trust.mjs
restrict-traffic.mjs
write-report.mjs
update-webgl-comment.mjs

# --- per-machine config (scripts/install-service-windows.ps1) ------------------------------------
scripts/service.env.cmd
.env
.env.*
plugins/.studio-key
plugins/config.json

